# Required. Used for extraction, tool-calling, and web_search grounding.
GEMINI_API_KEY=your-gemini-api-key-here

# Groq vision for extracting visible text and observations from uploaded images.
GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional overrides (defaults shown).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
WHISPER_MODEL=base

# check_route: urban two-wheeler average speed applied to OSRM's real distance.
# OSRM's public server has no traffic data or two-wheeler profile, so its raw time is
# free-flow driving. The raw time is always returned next to the adjusted one.
ROUTE_AVG_SPEED_KMH=20

# Optional: Cloudflare Workers AI credentials for image generation.
# Without both values, image generation returns an SVG placeholder.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Local defaults. For an HTTPS deployment use production and set the exact frontend
# origin(s), for example https://veritas.example.org. Each origin omits the trailing slash.
# VERITAS_ENV=development
# VERITAS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo sign-in is enabled in development and disabled in production by default.
# VERITAS_ENABLE_DEMO=0
# VERITAS_DB=/path/to/veritas.db
# VERITAS_UPLOADS=/path/to/uploads
# VERITAS_GENERATED=/path/to/generated
