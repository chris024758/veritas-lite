# Required. Used by extraction and the LangGraph tool-calling verifier.
GROQ_API_KEY=your-groq-api-key-here
# Optional account-specific override. Developer plans can use qwen/qwen3.8-27b.
# GROQ_MODEL=qwen/qwen3.8-27b

# Optional overrides (defaults shown).
WHISPER_MODEL=base

# check_route: urban two-wheeler average speed applied to OSRM's real distance.
# OSRM's public server has no traffic data or two-wheeler profile, so its raw time is
# free-flow driving. The raw time is always returned next to the adjusted one.
ROUTE_AVG_SPEED_KMH=20
